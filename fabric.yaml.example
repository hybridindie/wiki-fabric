# Wiki Fabric configuration (example)
# Copy this file to fabric.yaml and edit for your setup.
# fabric.yaml is gitignored — it contains personal repo paths and settings.

# Optional Obsidian vault — the utility's standalone OUTPUT directory.
# wiki-fabric writes generated content (the rendered wiki via `wf export wiki`)
# into it; it never copies or symlinks the corpus in. Because it is standalone
# output, you can point at several targets to get multiple vaults on one
# machine (e.g. work vs personal). Relative paths resolve against the fabric
# root. Set to "" to disable; unset defaults to a sibling `vault/`. The
# WIKI_FABRIC_VAULT env var overrides.
# vault:
#   path: ../vault

owner: your-name

llm:
  # Any OpenAI-compatible endpoint works: Ollama, LM Studio, vLLM,
  # llama.cpp server, MLX-VM, OpenRouter, Together AI, etc.
  base_url: http://localhost:11434/v1   # Ollama default (see presets below)
  api_key: ollama                        # Ollama ignores this; cloud providers need a real key
  model: qwen2.5-coder:7b               # ops model: cheap queries, capture, status

  # Other tested endpoints:
  #   LM Studio:        http://localhost:1234/v1
  #   vLLM:             http://localhost:8000/v1
  #   mlx-serve:        http://localhost:8000/v1   (MLX hot-swap server, macOS only)
  #   mlx-openai-server: http://localhost:8080/v1  (MLX server, macOS only)
  #   OpenRouter:       https://openrouter.ai/api/v1  (api_key: your key)
  #   Together AI:      https://api.together.xyz/v1   (api_key: your key)
  # compiler_model: deepseek-v4.1-flash:cloud  # claim extraction, synthesis, promotion.
  # Policy (eval-stability G4): compiler work needs the most capable model; model
  # swaps require a recorded compiler eval (promote/mine refuse without it).

  # local_model: resolves repos.<slug>.<stage>="local" routes (extraction,
  # synthesis on-device). Default when unset — platform-split:
  #   Apple Silicon: mlx-community/gemma-4-e4b-it-4bit   (MLX, 34s/doc)
  #   other:         unsloth/gemma-4-e4b-it-GGUF         (llama.cpp/GGUF)
  # Missing models are offered for download at first use (human-gated), or
  # pre-fetch with: wf models ensure [--yes]
  # local_model: mlx-community/gemma-4-e4b-it-4bit

repos:
  # my-project:
  #   path: ../my-project               # relative to fabric root, or absolute
  #   graph_dir: graphify-out            # optional, for graphify integration
#   #
#   # Per-stage LLM routing (privacy + quality tiering):
#   #   extract:    summarize + claim extraction (sees raw docs - highest sensitivity)
#   #   synthesize: concept synthesis from claims (sees sanitized statements)
#   #   dossier:    promotion dossier generation (sees experience events)
#   #
#   # Values: "cloud" (default) | "local" (on-device; MLX on macOS, GGUF
#   # elsewhere — see llm.local_model) | explicit model name
#   extract: local                        # raw docs never leave the machine
#   synthesize: local                     # extracted claims stay local too
#   dossier: cloud                        # experience events are safe for cloud

# Optional ignores: exclude-side filter applied by capture, entity index,
# context selection, lint, rebuild-index, and okf export.
#
# One list, auto-classified (preferred): glob by default; a pattern with a
# regex-only metacharacter (\ ( ) { } + | ^) is compiled as a regex; prefix
# `regex:` to force regex matching on ambiguous strings.
# ignore:
#   patterns:
#     - "vendor/**"                  # glob (fnmatch-style, ** crosses dirs)
#     - "docs/generated/**"
#     - "_archive\\d+/"              # regex (auto-detected)
#     - "regex:^temp-\\d+\\.tmp$"   # forced regex
#   projects:                        # per-repo, unioned with global
#     my-godot-game:
#       patterns:
#         - "addons/generated/**"
#
# Explicit keys still work (and win for ambiguous strings):
# ignore:
#   globs:
#     - "vendor/**"
#   regexes:
#     - "_archive\\d+/"

# Optional integrations — all off by default; enable explicitly.
# When active, skills gain graph-aware steps (see system/skills/*/SKILL.md).
integrations:
  graphify:
    enabled: false                       # true → call-graph staleness, claim enrichment, graph expansion
    graph_dir: graphify-out
  embeddings:
    enabled: false                       # true → semantic re-rank boost on wf query (optional ML)
    model: all-MiniLM-L6-v2              # fastembed ONNX, offline, ~30MB, ~5ms/query
    # Value conditions (exp-embeddings-spike-2026-09-28): at ~500 claims the
    # gain is thin (+3 rel@10 over lexical+graph, no rel@5 change). Ship-worth
    # grows with corpus scale (lexical collisions multiply, embedding space
    # doesn't) and with cross-project queries (word divergence between
    # projects). Re-run the benchmark at ~2k claims / after a logged
    # retrieval miss. Off by default — the deterministic retriever stands alone.
  judgment:
    enabled: false                       # true → low-variance decision-model judging (eval gates)
    route: cloud                         # "cloud" (TypeSafe Jev API) | "local" (on-device)
    cloud_model: jev-latest              # Jev model id (cloud route)
    # optional: key/endpoint in config (env TYPESAFE_API_KEY wins)
    # api_key: <jev key>            # gitignored file — ok for secrets
    # base_url: http://localhost:8000  # self-hosted judge (stuntd/laya-serve)
    # Local route, platform split (auto unless you pin local_backend):
    #   Apple Silicon: laya-as-judge[mlx] typed heads — fastest (7-14ms)
    #   other OS:      upstream laya (pip laya, torch/ONNX) — same typed heads,
    #                  ~1-3s/question CPU; first load downloads ~430MB
    #   explicit:      local_backend: laya-mlx | laya-torch | generic
    #                  (generic = llm.local_model GGUF JSON verdicts, lowest fidelity)

# Tunable thresholds (defaults shown; provenance in machine-contract.md).
# calibration-sensitive values (judgment.mining_threshold) carry their
# derivation in issue history — change deliberately.
# tuning:
#   mining: {min_projects: 2, keyword_threshold: 0.05}
#   judgment: {mining_threshold: 0.8, near_band: 0.1}
#   context: {max_items: 20, nav_max_files: 5, excluded_cap: 15}
#   synthesize: {min_claims: 2}
#   export: {topic_min_claims: 6}

domains:
  agent-systems:
    signals: [agent, mcp, fastmcp, opencode, claude]
  web-systems:
    signals: [fastapi, flask, react, nextjs, supabase, postgresql]
  # Add domains as your evidence grows (propose-domains.py will suggest them)