+"""Tests for validation of nodes nested inside subgraph node maps."""
+
+from workflow.validation import (
+    find_dangerous_nodes,
+    find_output_nodes,
+    find_prompt_nodes,
+    validate_workflow,
+)
+
+
+def _subgraph_node(node_id, inner_nodes, class_type="SubgraphNode"):
+    return {
+        "id": node_id,
+        "class_type": class_type,
+        "subgraph": {"nodes": inner_nodes},
+    }
+
+
+def test_prompt_node_inside_subgraph_is_found():
+    workflow = {
+        "nodes": {
+            "1": _subgraph_node(
+                "1",
+                {
+                    "2": {
+                        "id": "2",
+                        "class_type": "CLIPTextEncode",
+                        "widgets_values": {"text": "a cat"},
+                    }
+                },
+            )
+        }
+    }
+    prompts = find_prompt_nodes(workflow)
+    assert len(prompts) == 1
+    assert prompts[0]["node_id"] == "2"
+    assert prompts[0]["text"] == "a cat"
+    assert "subgraph" in prompts[0]["path"]
+
+    result = validate_workflow(workflow)
+    assert any(
+        issue.code == "prompt_node" and issue.node_id == "2"
+        for issue in result.issues
+    )
+
+
+def test_dangerous_node_inside_subgraph_warns():
+    workflow = {
+        "nodes": {
+            "1": _subgraph_node(
+                "1",
+                {
+                    "2": {"id": "2", "class_type": "ExecutePython"},
+                },
+            )
+        }
+    }
+    dangerous = find_dangerous_nodes(workflow)
+    assert len(dangerous) == 1
+    assert dangerous[0]["node_id"] == "2"
+
+    result = validate_workflow(workflow)
+    warnings = [i for i in result.warnings if i.code == "dangerous_node"]
+    assert len(warnings) == 1
+    assert warnings[0].node_id == "2"
+    assert "subgraph" in (warnings[0].path or "")
+
+
+def test_output_node_inside_subgraph_satisfies_output_check():
+    workflow = {
+        "nodes": {
+            "1": _subgraph_node(
+                "1",
+                {
+                    "2": {"id": "2", "class_type": "SaveImage"},
+                },
+            )
+        }
+    }
+    outputs = find_output_nodes(workflow)
+    assert len(outputs) == 1
+    assert outputs[0]["node_id"] == "2"
+
+    result = validate_workflow(workflow)
+    assert not any(issue.code == "no_output_node" for issue in result.issues)
+    assert result.valid is True
