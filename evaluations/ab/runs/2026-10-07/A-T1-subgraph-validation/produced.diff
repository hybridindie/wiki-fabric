+"""Tests for subgraph-aware workflow validation."""
+
+from workflow.validation import (
+    collect_prompts,
+    find_dangerous_nodes,
+    find_output_nodes,
+    validate_workflow,
+)
+
+
+def _subgraph_node(inner_nodes):
+    return {
+        "type": "SubgraphNode",
+        "inputs": {},
+        "subgraph": {"nodes": inner_nodes},
+    }
+
+
+def test_prompt_inside_subgraph_is_found():
+    workflow = {
+        "nodes": {
+            "1": _subgraph_node(
+                {
+                    "10": {
+                        "type": "CLIPTextEncode",
+                        "inputs": {"text": "a cat in space"},
+                    }
+                }
+            )
+        }
+    }
+    prompts = collect_prompts(workflow)
+    assert ("10", "a cat in space") in prompts
+    result = validate_workflow(workflow)
+    assert result["prompts"] == [("10", "a cat in space")]
+
+
+def test_dangerous_node_inside_subgraph_warns():
+    workflow = {
+        "nodes": {
+            "1": _subgraph_node(
+                {"20": {"type": "ExecutePython", "inputs": {}}}
+            )
+        }
+    }
+    assert find_dangerous_nodes(workflow) == ["20"]
+    result = validate_workflow(workflow)
+    assert any("dangerous" in w for w in result["warnings"])
+
+
+def test_output_node_inside_subgraph_satisfies_output_check():
+    workflow = {
+        "nodes": {
+            "1": _subgraph_node(
+                {
+                    "30": {
+                        "type": "CLIPTextEncode",
+                        "inputs": {"text": "hi"},
+                    },
+                    "31": {"type": "SaveImage", "inputs": {}},
+                }
+            )
+        }
+    }
+    assert find_output_nodes(workflow) == ["31"]
+    result = validate_workflow(workflow)
+    assert not any("output" in i for i in result["issues"])
+    assert result["valid"] is True
