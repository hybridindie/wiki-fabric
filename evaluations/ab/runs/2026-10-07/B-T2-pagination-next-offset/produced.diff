     offset: int
     limit: int
     has_more: bool
+    next_offset: int | None
 
 
 def paginate(  # noqa: UP047
@@ -36,18 +37,23 @@ def paginate(  # noqa: UP047
         max_limit: Hard cap on page size.
 
