# === User config (personal) ===
fabric.yaml

# === Content (user data — harness ships only tooling, not your fabric) ===
# All content lives in the vault (sibling by default) — never in the harness.
evidence/
global/entities/
global/graphs/
patterns/**
!patterns/.gitkeep
anti-patterns/**
!anti-patterns/.gitkeep
skills/**
!skills/.gitkeep
concepts/**
!concepts/.gitkeep
projects/*/experience-events/*.md
projects/*/decisions/*.md
projects/*/README.md
registry/log.md
registry/catalog.json
registry/wiki-graph.json
registry/promotions/
registry/promotion-queue.md
registry/conflicts/
domains/**
!domains/.gitkeep
syntheses/**
!syntheses/.gitkeep
wiki/

# === Obsidian workspace ===
.obsidian/

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/
venv/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === Temporary ===
*.tmp
*.temp
*.log
.DS_Store
.okflint/

# graphify self-graph artifacts (regenerated: graphify --update). Build output —
# not tracked. A .gitkeep preserves the dir.
graphify-out/*
!graphify-out/.gitkeep
docs/site/node_modules/
docs/site/dist/
projects/*/overlay.yml
tests/_bridge_fixture_fabric/
